#!/usr/bin/env python3
"""pipeline: the ticket clock. Moves every in-flight ticket through implement -> rebase -> checks -> one review ->
fix round on its own, so no finished round waits for the coordinator, and hands approvals to the coordinator, who
merges them (or, with `auto_merge`, merges them itself through `pipeline merge`; `auto_start` also starts the next
unblocked tickets). Otherwise it never pushes, never touches the shared stack (Docker, servers, the main
checkout) and never starts a live gate: it only runs model rounds through run-model, the project checks in the
ticket's worktree, and bin/review.

  pipeline run [--interval S] [--once]           # the loop; start it under bin/bgrun (one `tick` line per pass)
  pipeline start <ISSUE> [--wt PATH] [--pool P]  # put a planned ticket in flight: round 1 brief + Tier 3 implementer.
                                                  # Sets the Linear state to In Progress (or the team's started state);
                                                  # a Linear failure is a warning and never blocks the start.
  pipeline fix <ISSUE> <findings.md>             # the coordinator's own next round (after triage, or instead of a stuck step)
  pipeline retry <ISSUE>                         # a stuck ticket: redo the step that got stuck
  pipeline merge <ISSUE> "<subject>" "<body>"    # merge an approved ticket: rebase, squash, bin/finish (exit 3: conflict)
  pipeline status                                # the RUN verdict, one line per in-flight ticket, then the ETA lines of bin/eta
  pipeline wait-approval [--interval S] [--tick S] [--stuck-after S]
                                                  # the coordinator's one wake-up job. Returns with: the lines of
                                                  # approved.txt / attention.txt; or the `RUN:` line once the run is
                                                  # DONE or WAITING ON OWNER, or has been STUCK or STOPPED for --stuck-after
                                                  # (300 s); or `TICK` + the `RUN:` line after --tick (600 s; 0: never).
                                                  # It never waits for nothing.

Per ticket, state.json `inflight.<ISSUE>`: `wt`, `round`, `stage`, `stage_at`, optional `pool` (review pool for
bin/review), and the pipeline's own bookkeeping (`tries`, `merges`, `why`, `stuck_from`). Stages the loop drives:
  implement  round <n> runs; its run-model JSON line lands in .autopilot/out/<ISSUE>-impl-<n>.json. ok -> rebase.
  merge      a merge-only round after a rebase conflict: brief <ISSUE>-impl-<n>m<k>.md, --no-escalate, same round.
  rebase     bring the worktree onto state.json `branch` (bin/rebase-wt: own commits are rebased, a conflict is left
             in progress); conflict -> merge round, else -> review once a check slot is free (`max_jobs`).
  review     the checks (ticket `CHECKS:` line, else state.json `checks`), then one bin/review run, in the background;
             progress in .autopilot/pipeline/<ISSUE>-<n>.check. Check failed or changes -> fix round <n+1>;
             approve -> approved; no verdict -> the review again (`review_retries`), then stuck.
  final      two-level checks only (state.json `checks_fast` or a ticket `CHECKS_FAST:` line): each round runs the fast
             checks before its review; once the review approves, the full checks run here, once, `max_full_jobs` at a
             time (progress in .autopilot/pipeline/<ISSUE>-<n>.final). Pass -> approved; fail -> fix round.
  approved   listed in .autopilot/pipeline/approved.txt (`<ISSUE> r<n>`) until `pipeline merge` takes it; with
             `auto_merge` the loop merges it itself (subject `<merge_prefix>: <ticket title> [<ISSUE>]`), logged in
             .autopilot/pipeline/merged.txt.
  starting   `auto_start`: worktree created, `setup` then `pipeline start` running in the background (log
             .autopilot/out/<ISSUE>-start.log).
  triage     round `max_rounds` (5) still has findings and the review is not converging (a review with fewer blocking
             findings than the previous one goes on by itself, up to `max_rounds_hard`); or the implementer reported
             `STATUS: blocked`; or a round changed nothing twice (the second run one tier up). The coordinator settles
             it (`pipeline fix`, or merge).
  stuck      a step failed beyond its retries: CRITICAL alert, the coordinator looks, then `pipeline retry`.
Any other stage (plan, hold, ...) is left alone. triage and stuck tickets are listed in attention.txt.
Fix rounds go through `run-model run implement --role fix` with the brief <ISSUE>-impl-<n>.md, so run-model's
automatic escalation after round 3 applies. Every fix brief ends with the rule that the full checks must pass.
`pipeline start` refuses a ticket whose state.json `blockers` are not all in `done` (`--force` overrides).
`auto_start` starts queued tickets by itself: blockers merged, `Touches` line of the ticket file not overlapping a
ticket in flight (shared test and docs paths excepted), up to `target_inflight` (0: 2 x max_jobs).
Settings: state.json `pipeline` {interval 60, max_jobs 3, max_rounds 5, max_rounds_hard 8, max_merges 3,
review_retries 3, impl_retries 3, retry_minutes 10, check_timeout_minutes 60, check_silence_minutes 25, max_full_jobs 2,
auto_merge false, auto_start false, target_inflight 0, setup "", merge_prefix "feat"}. Log: .autopilot/pipeline/pipeline.log.
Tests: PIPELINE_SYNC=1 runs every dispatch in the foreground; PIPELINE_RUN_MODEL, PIPELINE_REVIEW, PIPELINE_FINISH
(any bin script name) replace that script.
"""
import datetime as dt, fcntl, glob, json, os, re, signal, subprocess, sys, time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import autopilot_lib as lib

SELF = os.path.realpath(__file__)
DEFAULTS = {'interval': 60, 'max_jobs': 3, 'max_rounds': 5, 'max_merges': 3, 'review_retries': 3, 'impl_retries': 3,
            'retry_minutes': 10, 'check_timeout_minutes': 60, 'check_silence_minutes': 25,
            # The coordinator stops being the clock (all opt-in):
            'auto_merge': False,      # approved (after the full checks) -> `pipeline merge` by the loop itself
            'auto_start': False,      # queued tickets whose blockers are merged start by themselves, up to target_inflight
            'target_inflight': 0,     # 0: 2 x max_jobs
            'setup': '',              # command run in a new worktree before round 1 (e.g. `npm ci --prefer-offline`)
            'max_full_jobs': 2,       # full check suites at once (two-level checks), on top of max_jobs
            'max_rounds_hard': 8,     # past max_rounds a review that keeps converging (fewer findings) goes on, up to here
            'merge_prefix': 'feat',   # subject of an automatic merge: `<prefix>: <ticket title> [<ISSUE>]`
            'gc_minutes': 60}         # worktree garbage collection (bin/gc) every N minutes; 0: never
DRIVEN = ('implement', 'merge', 'rebase', 'review', 'final')
SHARED = re.compile(r'(^|/)(tests?|__tests__|docs)(/|$)|\.(test|spec)\.|(^|/)test_[^/]*\.py$|_test\.py$')
GRACE = 90  # seconds before a run or job with no process and no result counts as dead (dispatch races)
MARK = '@@pipeline '  # marker lines of a .check file; check output never starts with it
M = PD = OUT = None
EVENTS = []
_PROCS = None
STARTED = [0, 0]  # jobs (round, full-check) started during this tick: not yet in the ps snapshot


class Stop(Exception):
    """A ticket step that cannot go on without the coordinator (missing ticket file, a script refusing)."""


def tool(name):
    return os.environ.get('PIPELINE_' + name.upper().replace('-', '_')) or os.path.join(lib.HERE, name)


def env(**extra):
    e = dict(os.environ, AUTOPILOT_REPO=M)
    for k, v in extra.items():
        if v is None:
            e.pop(k, None)
        else:
            e[k] = v
    return e


def cfg(st):
    return dict(DEFAULTS, **(st.get('pipeline') or {}))


def log(msg):
    EVENTS.append(msg)
    with open(os.path.join(PD, 'pipeline.log'), 'a') as f:
        f.write('%s %s\n' % (dt.datetime.now().strftime('%m-%d %H:%M:%S'), msg))


def procs():
    """Command lines of every process, read once per tick."""
    global _PROCS
    if _PROCS is None:
        _PROCS = subprocess.run(['ps', '-ax', '-o', 'command='], capture_output=True, text=True).stdout.splitlines()
    return _PROCS


def run_alive(name):
    return any('/' + name + '.md' in c for c in procs())


def job_alive(t, r):
    for c in procs():
        a = c.split()
        if '_job' in a:
            i = a.index('_job')
            if a[i + 1:i + 3] == [t, str(r)]:
                return True
    return False


def kill_job(t, r):
    """Stops this project's check + review job of a ticket round, with its process group."""
    out = subprocess.run(['ps', '-ax', '-o', 'pid=,command='], capture_output=True, text=True).stdout
    for line in out.splitlines():
        pid, _, cmd = line.strip().partition(' ')
        a = cmd.split()
        if '_job' in a and SELF in cmd:
            i = a.index('_job')
            if a[i + 1:i + 3] == [t, str(r)]:
                try:
                    os.killpg(os.getpgid(int(pid)), signal.SIGKILL)
                except (ProcessLookupError, PermissionError, ValueError):
                    pass


def jobs_running():
    # Count only this project's jobs: several projects run the same pipeline script on one machine,
    # and another project's check jobs must not take this project's max_jobs slots (2026-11-20).
    # Full-check jobs (`--final`) have their own limit (`max_full_jobs`) and take no round slot.
    return STARTED[0] + own_jobs(final=False)


def own_jobs(final):
    own = set(lib.load_state(M).get('inflight', {}))
    n = 0
    for c in procs():
        a = c.split()
        if '_job' in a and SELF in c and ('--final' in a) == final:
            i = a.index('_job')
            if i + 1 < len(a) and a[i + 1] in own:
                n += 1
    return n


def spawn(argv, out=None, extra_env=None):
    """Background by default (own session, stdin closed); PIPELINE_SYNC=1 runs it in the foreground."""
    f = open(out, 'w') if out else subprocess.DEVNULL
    kw = dict(cwd=M, env=env(**(extra_env or {})), stdin=subprocess.DEVNULL, stdout=f,
              stderr=subprocess.STDOUT if out else subprocess.DEVNULL)
    try:
        if os.environ.get('PIPELINE_SYNC') == '1':
            subprocess.run(argv, **kw)
        else:
            subprocess.Popen(argv, start_new_session=True, **kw)
    finally:
        if out:
            f.close()


def result(path):
    """run-model's final JSON line (stderr lines such as `run-model: escalate ...` share the file), or None."""
    if not os.path.exists(path):
        return None
    for line in reversed(open(path, errors='ignore').read().splitlines()):
        if line.startswith('{'):
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if 'status' in d:
                return d
    return None


def age(v):
    try:
        return (lib.now() - lib.parse_time(v['stage_at'])).total_seconds()
    except (KeyError, ValueError, TypeError):
        return float('inf')


def rnd(v):
    return int(v.get('round') or 1)


def wt_of(st, t, v=None):
    v = v or st.get('inflight', {}).get(t) or {}
    return v.get('wt') or os.path.join(lib.worktrees_dir(M, st), t)


def ticket_file(t):
    return os.path.join(M, '.autopilot', 'tickets', t + '.md')


def ticket_line(t, key):
    tf = ticket_file(t)
    mt = re.search(r'^%s:(.*)$' % key, open(tf).read(), re.M) if os.path.exists(tf) else None
    return mt.group(1).strip() if mt and mt.group(1).strip() else None


def shell_line(t, key):
    """A ticket's `CHECKS:`/`CHECKS_FAST:` line, only when it parses as a shell command (`bash -n`). Planners sometimes
    write prose there ("just check (and the named tests: x.py)"): on 2026-11-20 that line reached the full checks as a
    command, bash failed on the parenthesis, and an approved ticket went to triage for a syntax error that was not its
    own. A line that does not parse is ignored (logged once per ticket and key) and the project's checks apply."""
    line = ticket_line(t, key)
    if not line:
        return None
    if subprocess.run(['bash', '-n', '-c', line], capture_output=True).returncode == 0:
        return line
    if (t, key) not in _BAD_LINES:
        _BAD_LINES.add((t, key))
        log('%s: ignoring %s line that is not a shell command: %s' % (t, key, line[:120]))
    return None


_BAD_LINES = set()


def checks_of(st, t):
    """The full checks: the ticket's `CHECKS:` line, else state.json `checks`."""
    line = shell_line(t, 'CHECKS')
    return [line] if line else list(st.get('checks', []))


def fast_checks_of(st, t):
    """Two-level checks: the per-round checks (ticket `CHECKS_FAST:`, else state.json `checks_fast`), or None when the
    project has none (then every round runs the full checks, as before). With fast checks, each round runs them before
    its review, and the full checks run once, after the review approves (stage `final`), `max_full_jobs` at a time:
    on 2026-11-20 ten full suites (unit + build + e2e, 25 min each) ran at once on one machine and unrelated tests
    timed out, sending tickets to triage for failures that were not theirs."""
    line = shell_line(t, 'CHECKS_FAST')
    if line:
        return [line]
    return list(st['checks_fast']) if st.get('checks_fast') else None


def round_checks(st, t):
    fast = fast_checks_of(st, t)
    return fast if fast is not None else checks_of(st, t)


def final_rule(st, t):
    fast = fast_checks_of(st, t)
    if fast is not None:
        return ('Before finishing: run the fast checks (`%s`) and the tests that cover what you changed, and make them '
                'pass; a round with failing checks is rejected. The pipeline runs the full suite (`%s`) once the review '
                'approves: do not run the whole end-to-end suite yourself.' % (' && '.join(fast), ' && '.join(checks_of(st, t))))
    cs = ' && '.join(checks_of(st, t)) or 'the project checks'
    return ('Before finishing: run the full checks (`%s`) and make them pass; a round with failing checks is '
            'rejected.' % cs)


def impl_report(res, name):
    """(STATUS, NOTES) of the implementer's final block, ('', '') when absent."""
    p = res.get('out') or os.path.join(OUT, name + '.md')
    text = open(p, errors='ignore').read() if os.path.exists(p) else ''
    s = re.findall(r'^\W*STATUS:\W*(\w+)', text, re.M)
    n = re.search(r'^\W*NOTES:(.*)', text, re.M | re.S)
    # One line: the reason lands in attention.txt, one line per ticket.
    return (s[-1].lower() if s else ''), (' '.join(n.group(1).split())[:600] if n else '')


def tree_changed(wt, branch):
    """True when the worktree differs from the project branch (uncommitted or untracked work, or commits of its own)."""
    if lib.git(wt, 'status', '--porcelain', '--untracked-files=normal').stdout.strip():
        return True
    ahead = lib.git(wt, 'rev-list', '--count', '%s..HEAD' % branch).stdout.strip()
    return ahead not in ('', '0')


def tree_print(wt):
    """Fingerprint of a worktree's content: HEAD, the uncommitted diff and the untracked files (name, size, mtime).
    Implementers never commit, so from round 2 the tree always differs from the branch: a fix round that changed
    nothing is seen by comparing the fingerprint taken when the round was dispatched."""
    import hashlib
    h = hashlib.sha1()
    h.update(lib.git(wt, 'rev-parse', 'HEAD').stdout.encode())
    h.update(subprocess.run(['git', '-C', wt, 'diff', 'HEAD'], capture_output=True).stdout)  # bytes: diffs are not always UTF-8
    for f in sorted(lib.git(wt, 'ls-files', '-o', '--exclude-standard').stdout.splitlines()):
        try:
            s = os.stat(os.path.join(wt, f)); h.update(('%s %s %s\n' % (f, s.st_size, s.st_mtime_ns)).encode())
        except OSError:
            pass
    return h.hexdigest()


def round_changed(wt, v, branch):
    return tree_print(wt) != v['tree'] if v.get('tree') else tree_changed(wt, branch)


def touches_of(t):
    """Paths of the ticket's `Touches` line (backticked), without the shared test and docs paths."""
    tf = ticket_file(t)
    if not os.path.exists(tf):
        return set()
    mt = re.search(r'^\W*Touches[^:\n]*:(.*)$', open(tf).read(), re.M | re.I)
    if not mt:
        return set()
    return {p.strip().rstrip('/') for p in re.findall(r'`([^`]+)`', mt.group(1))
            if p.strip() and not SHARED.search(p.strip()) and ' ' not in p.strip()}


def overlaps(a, b):
    return any(x == y or x.startswith(y + '/') or y.startswith(x + '/') for x in a for y in b)


def n_findings(body):
    return len(re.findall(r'^- \[', body, re.M))


def transition(t, expect, r, **fields):
    """Compare-and-set on inflight.<t>: applies `fields` only while the ticket is still at stage `expect` (None: any)
    and round `r` (None: any), so an edit the coordinator made meanwhile always wins. A None value deletes the field."""
    if 'stage' in fields:
        fields.setdefault('stage_at', lib.now().isoformat())

    def fn(st):
        v = st.get('inflight', {}).get(t)
        if v is None or (expect is not None and v.get('stage') != expect) or (r is not None and rnd(v) != r):
            return False
        for k, x in fields.items():
            if x is None:
                v.pop(k, None)
            else:
                v[k] = x
        return True
    return lib.update_state(M, fn)


def mkbrief(kind, t, n, wt, findings=None):
    if not os.path.exists(ticket_file(t)):
        raise Stop('no ticket file %s' % ticket_file(t))
    p = subprocess.run([tool('mkbrief'), kind, t, str(n), ticket_file(t)] + ([findings] if findings else []),
                       cwd=M, env=env(WT=wt), capture_output=True, text=True)
    if p.returncode or not p.stdout.strip():
        raise Stop('mkbrief %s %s %s failed: %s' % (kind, t, n, (p.stderr or p.stdout).strip()[-300:]))
    return p.stdout.strip().splitlines()[-1]


def run_args(t, v):
    """(run name, extra run-model args) of the ticket's current round: the run name is the brief and output basename."""
    r = rnd(v)
    if v.get('stage') == 'merge' or (v.get('stage') == 'stuck' and v.get('stuck_from') == 'merge'):
        return '%s-impl-%sm%s' % (t, r, v.get('merges', 1)), ['--role', 'fix', '--no-escalate']
    return '%s-impl-%s' % (t, r), (['--role', 'fix'] if r > 1 else [])


def linear_in_progress(t):
    """Best effort: Linear state In Progress, else the team's started state. A failure warns and never blocks the start."""
    try:
        st = lib.load_state(M)
        env = dict(os.environ)
        if not env.get('LINEAR_API_KEY'):
            kf = os.path.expanduser(st.get('linear_key_file') or '')
            if kf and os.path.exists(kf):
                env['LINEAR_API_KEY'] = open(kf).read().strip()
        if not env.get('LINEAR_API_KEY'):
            print('pipeline start: WARNING Linear state not updated for %s: LINEAR_API_KEY is not set' % t, file=sys.stderr)
            return
        p = subprocess.run([os.path.join(os.path.dirname(SELF), 'linear'), 'state', t, 'In Progress', 'started'],
                           capture_output=True, text=True, env=env, stdin=subprocess.DEVNULL)
        if p.returncode != 0:
            msg = [x for x in (p.stderr or p.stdout or '').splitlines() if x.strip()]
            print('pipeline start: WARNING Linear state not updated for %s: %s' % (t, (msg[-1] if msg else 'linear state failed')[:300]),
                  file=sys.stderr)
    except Exception as ex:
        print('pipeline start: WARNING Linear state not updated for %s: %s' % (t, ex), file=sys.stderr)


def dispatch(t, wt, name, extra):
    brief = os.path.join(M, '.autopilot', 'briefs', name + '.md')
    spawn([tool('run-model'), 'run', 'implement', brief, os.path.join(OUT, name + '.md'), '--cwd', wt, '--issue', t] + extra,
          out=os.path.join(OUT, name + '.json'))


def lines(path):
    return [x for x in open(path).read().splitlines() if x.strip()] if os.path.exists(path) else []


def write_lines(path, ls):
    tmp = path + '.tmp'
    with open(tmp, 'w') as f:
        f.write(''.join(x + '\n' for x in ls))
    os.replace(tmp, path)


def drop_approved(t):
    p = os.path.join(PD, 'approved.txt')
    ls = lines(p)
    keep = [x for x in ls if x.split()[0] != t]
    if keep != ls:
        write_lines(p, keep)


def stuck(t, frm, r, why):
    if transition(t, None, r, stage='stuck', stuck_from=frm, why=why[:500]):
        log('%s r%s: STUCK in %s: %s' % (t, r, frm, why[:300]))
        lib.raise_alert(M, 'pipeline_stuck', t, 'CRITICAL: %s stuck in the pipeline' % t,
                        '%s round %s stuck in %s: %s (pipeline status; pipeline retry %s)' % (t, r, frm, why[:300], t),
                        {'issue': t, 'round': r, 'stage': frm})


def marks(ck):
    out = {}
    if os.path.exists(ck):
        for line in open(ck, errors='ignore'):
            if line.startswith(MARK):
                k, _, rest = line[len(MARK):].strip().partition(' ')
                out[k] = rest
    return out


def check_path(t, r):
    return os.path.join(PD, '%s-%s.check' % (t, r))


# ---------- the steps ----------

def start_job(t, r, wt, expect, review_only=False):
    """The checks then one review, in the background. The .check file is reset before the job starts, so a DONE
    marker the loop reads always belongs to the current job."""
    if not transition(t, expect, r, stage='review'):
        return
    with open(check_path(t, r), 'w') as f:
        f.write('%sSTART %s%s\n' % (MARK, lib.now().isoformat(), ' review-only' if review_only else ''))
        if review_only:  # the checks passed on this tree in the previous job; a later retry must not rerun them either
            f.write('%sCHECK_OK (previous job)\n' % MARK)
    log('%s r%s: %s' % (t, r, 'review again' if review_only else 'implemented -> checks + review'))
    if os.environ.get('PIPELINE_SYNC') != '1':
        STARTED[0] += 1
    spawn([sys.executable, SELF, '_job', t, str(r)] + (['--review-only'] if review_only else []))


def rebase(t, v, st, c):
    r, wt = rnd(v), wt_of(st, t, v)
    if jobs_running() >= c['max_jobs']:
        return  # stays in `rebase` until a check slot frees up (status: waiting for a check slot)
    p = subprocess.run([tool('rebase-wt'), wt, st['branch']], capture_output=True, text=True, env=env(), stdin=subprocess.DEVNULL)
    out = (p.stdout + p.stderr).strip()
    if p.returncode == 0:
        start_job(t, r, wt, 'rebase')
    elif p.returncode == 3 or 'CONFLICT' in out:
        merge_round(t, v, st, c, out)
    else:
        stuck(t, 'rebase', r, 'rebase-wt rc=%s: %s' % (p.returncode, out[-300:]))


def merge_round(t, v, st, c, why):
    r, wt = rnd(v), wt_of(st, t, v)
    k = int(v.get('merges') or 0) + 1
    if k > c['max_merges']:
        stuck(t, 'rebase', r, '%d merge rounds did not resolve the rebase conflict: %s' % (k - 1, why[-300:]))
        return
    fx = os.path.join(OUT, '%s-merge-%s-%s.md' % (t, r, k))
    with open(fx, 'w') as f:
        f.write(
            'MERGE-ONLY ROUND. The worktree was rebased onto the project branch `%s` and conflicted:\n\n```\n%s\n```\n\n'
            'Resolve it, nothing else:\n'
            '- `git status` first. A rebase in progress: resolve every conflicted (UU) file keeping the intent of both sides, '
            'no conflict markers left, `git add` it, then `GIT_EDITOR=true git rebase --continue`, until the rebase completes '
            '(this round is the one exception to the no-git rule: finishing that rebase is the job; no other commit). The '
            'ticket\'s uncommitted work is the last commit of the rebase (`autopilot-wip ...`): keep it a commit.\n'
            '- Unmerged (UU) files without a rebase in progress (a stash re-applied with conflicts): resolve them the same way '
            'and `git add` them.\n'
            '- Never drop, pop or clear stash entries (they are backups), never `git reset --hard`, `git checkout -- .`, '
            '`git clean`, `git rebase --abort` or `git stash drop`.\n'
            '- No new features, no refactoring beyond the resolution.\n\n%s\n' % (st['branch'], why[-2500:], final_rule(st, t)))
    name = '%s-impl-%sm%s' % (t, r, k)
    try:
        mkbrief('impl', t, '%sm%s' % (r, k), wt, fx)
    except Stop as e:
        stuck(t, 'rebase', r, str(e)); return
    if transition(t, 'rebase', r, stage='merge', merges=k, tries=0):
        log('%s r%s: rebase conflict -> merge round %s' % (t, r, k))
        dispatch(t, wt, name, ['--role', 'fix', '--no-escalate'])


def fix_round(t, v, st, c, body, src, expect='review', forced=False):
    """Next round <n+1> with these findings; past `max_rounds` the ticket goes to the coordinator (triage) instead."""
    r, wt = rnd(v), wt_of(st, t, v)
    n = r + 1
    nf = n_findings(body) if src == 'changes' else None
    if r >= c['max_rounds'] and not forced and nf is not None and v.get('nfind') and nf < int(v['nfind']) \
            and r < c['max_rounds_hard']:
        # Converging: fewer blocking findings than the previous review. On 2026-11-20 most triages at max_rounds were
        # settled by the coordinator with "one more round"; the loop does that itself while the review converges.
        log('%s r%s: %d findings (was %s): converging, past max_rounds %s' % (t, r, nf, v['nfind'], c['max_rounds']))
        forced = True
    if r >= c['max_rounds'] and not forced:
        fp = os.path.join(OUT, '%s-triage-%s.md' % (t, r))
        with open(fp, 'w') as f:
            f.write(body + '\n')
        if transition(t, expect, r, stage='triage', why='%s after round %s of %s; findings: %s' % (src, r, c['max_rounds'], fp),
                      findings=fp, nfind=nf if nf is not None else v.get('nfind')):
            # nfind is kept so a coordinator round (`pipeline fix`) still lets the next review count as converging.
            log('%s r%s: %s -> TRIAGE (round %s reached)' % (t, r, src, c['max_rounds']))
        return
    fx = os.path.join(OUT, '%s-fix-%s.md' % (t, n))
    with open(fx, 'w') as f:
        f.write(body.rstrip() + '\n\n' + final_rule(st, t) + '\n')
    mkbrief('impl', t, n, wt, fx)
    if transition(t, expect, r, round=n, stage='implement', tries=0, merges=None, why=None, stuck_from=None, findings=None,
                  nfind=nf if nf is not None else v.get('nfind'), empty_retry=None, tree=tree_print(wt)):
        drop_approved(t)
        lib.resolve_alert(M, 'pipeline_stuck', t)
        log('%s r%s: %s -> fix round %s%s' % (t, r, src, n, ' (Tier 2 by escalation)' if n > escalate_after() else ''))
        dispatch(t, wt, '%s-impl-%s' % (t, n), ['--role', 'fix'])


def escalate_after():
    try:
        return int(lib.load_reg(warn=False).get('escalate_after_round', 3))
    except Exception:
        return 3


def final_path(t, r):
    return os.path.join(PD, '%s-%s.final' % (t, r))


def approve(t, r, st=None, expect='review'):
    """Review approved. Two-level checks: the full suite first (stage `final`), then approved."""
    st = st or lib.load_state(M)
    if expect == 'review' and fast_checks_of(st, t) is not None:
        if os.path.exists(final_path(t, r)):
            os.remove(final_path(t, r))
        if transition(t, 'review', r, stage='final', tries=0):
            log('%s r%s: review approved -> full checks' % (t, r))
        return
    p = os.path.join(PD, 'approved.txt')
    if transition(t, expect, r, stage='approved'):
        ls = [x for x in lines(p) if x.split()[0] != t]
        write_lines(p, ls + ['%s r%s' % (t, r)])
        lib.resolve_alert(M, 'pipeline_stuck', t)
        log('%s r%s: APPROVED' % (t, r))


def check_findings(ck):
    text = open(ck, errors='ignore').read()
    m = re.search('^' + re.escape(MARK) + r'CHECK_FAIL (.*)$', text, re.M)
    body = text[:m.start()] if m else text
    body = '\n'.join(x for x in body.splitlines() if not x.startswith(MARK))[-3000:]
    return 'The project checks failed (%s). Last lines of the output:\n\n```\n%s\n```\n' % (m.group(1) if m else '?', body)


def on_review(t, v, st, c):
    r = rnd(v)
    ck = check_path(t, r)
    mk = marks(ck)
    if 'DONE' not in mk:
        wt = wt_of(st, t, v)
        alive = job_alive(t, r)
        # A check that writes nothing for check_silence_minutes is hung (a test waiting forever, or orphans of a
        # runner that died and took its timeout with it). The review phase after CHECK_OK is bounded by run-model.
        silent = time.time() - os.path.getmtime(ck) if os.path.exists(ck) else 0
        if alive and 'CHECK_OK' not in mk and silent > c.get('check_silence_minutes', 25) * 60:
            kill_job(t, r)
            log('%s r%s: check silent for %d min, job and worktree processes stopped (%d)'
                % (t, r, silent // 60, len(lib.reap_worktree(wt))))
            alive = False
        if alive or age(v) < GRACE:
            return
        lib.reap_worktree(wt)  # orphans of the dead job must not keep running beside its rerun
        tries = int(v.get('tries') or 0)
        if tries >= c['review_retries']:
            stuck(t, 'review', r, 'the check + review job died %d times without a result (%s)' % (tries + 1, ck)); return
        transition(t, 'review', r, tries=tries + 1)
        log('%s r%s: check/review job died, starting it again' % (t, r))
        start_job(t, r, wt_of(st, t, v), 'review', review_only='CHECK_OK' in mk)
        return
    if 'CHECK_FAIL' in mk:
        fix_round(t, v, st, c, check_findings(ck), 'checks failed'); return
    rc = mk.get('REVIEW_RC', '')
    if rc == '0':
        approve(t, r, st)
    elif rc == '1':
        fp = os.path.join(OUT, '%s-findings-%s.md' % (t, r))
        body = open(fp).read() if os.path.exists(fp) else '(the reviewer asked for changes; no findings file)'
        fix_round(t, v, st, c, 'Blocking review findings to fix:\n\n' + body, 'changes')
    elif rc == '3':
        stuck(t, 'review', r, 'bin/review exit 3: a reviewer changed the history or the tree could not be restored; inspect %s '
              '(.autopilot/out/review-%s-%s.txt)' % (wt_of(st, t, v), t, r))
    else:
        tries = int(v.get('tries') or 0)
        if tries >= c['review_retries']:
            stuck(t, 'review', r, 'no review verdict after %d tries (bin/review rc=%s, .autopilot/out/review-%s-%s.txt)' % (tries + 1, rc, t, r))
            return
        if transition(t, 'review', r, tries=tries + 1):
            log('%s r%s: no verdict (review rc=%s) -> review again (%d/%d)' % (t, r, rc, tries + 1, c['review_retries']))
            start_job(t, r, wt_of(st, t, v), 'review', review_only=True)


def finals_running():
    return own_jobs(final=True) + STARTED[1]


def on_final(t, v, st, c):
    """Approved by the review, two-level checks: the full suite once, `max_full_jobs` at a time. Pass -> approved;
    fail -> fix round with the output (the next round's review then sees only that fix)."""
    r, wt = rnd(v), wt_of(st, t, v)
    fp = final_path(t, r)
    mk = marks(fp)
    if not os.path.exists(fp):
        if finals_running() >= c['max_full_jobs']:
            return  # waits for a full-check slot (status: final (slot))
        if lib.git(wt, 'rev-parse', '-q', '--verify', 'REBASE_HEAD').returncode == 0:
            stuck(t, 'final', r, 'a rebase is in progress in %s' % wt); return
        p = subprocess.run([tool('rebase-wt'), wt, st['branch']], capture_output=True, text=True, env=env(), stdin=subprocess.DEVNULL)
        out = (p.stdout + p.stderr).strip()
        if p.returncode == 3 or 'CONFLICT' in out:
            transition(t, 'final', r, stage='rebase')
            merge_round(t, dict(v, stage='rebase'), st, c, out); return
        if p.returncode:
            stuck(t, 'final', r, 'rebase-wt rc=%s: %s' % (p.returncode, out[-300:])); return
        with open(fp, 'w') as f:
            f.write('%sSTART %s final\n' % (MARK, lib.now().isoformat()))
        if os.environ.get('PIPELINE_SYNC') != '1':
            STARTED[1] += 1
        log('%s r%s: full checks' % (t, r))
        spawn([sys.executable, SELF, '_job', t, str(r), '--final'])
        return
    if 'DONE' not in mk:
        alive = job_alive(t, r)
        silent = time.time() - os.path.getmtime(fp)
        if alive and silent > c.get('check_silence_minutes', 25) * 60:
            kill_job(t, r)
            log('%s r%s: full check silent for %d min, stopped (%d)' % (t, r, silent // 60, len(lib.reap_worktree(wt))))
            alive = False
        if alive or silent < GRACE:
            return
        lib.reap_worktree(wt)
        tries = int(v.get('tries') or 0)
        if tries >= c['review_retries']:
            stuck(t, 'final', r, 'the full-check job died %d times without a result (%s)' % (tries + 1, fp)); return
        if transition(t, 'final', r, tries=tries + 1):
            os.remove(fp)
            log('%s r%s: full-check job died, starting it again' % (t, r))
        return
    if 'CHECK_FAIL' in mk:
        body = check_findings(fp) + ('\nThis is the full suite, run once the review had approved. This round, run the failing '
                                     'part of it yourself (the failing tests, not the whole suite) until it passes.\n')
        fix_round(t, v, st, c, body, 'full checks failed', expect='final'); return
    approve(t, r, st, expect='final')


def on_run(t, v, st, c):
    """implement / merge: wait for run-model's JSON line, then rebase; a dead or failed run is dispatched again (bounded)."""
    r, wt, stage = rnd(v), wt_of(st, t, v), v['stage']
    name, extra = run_args(t, v)
    js = os.path.join(OUT, name + '.json')
    res = result(js)
    tries = int(v.get('tries') or 0)
    if res is None:
        brief = os.path.join(M, '.autopilot', 'briefs', name + '.md')
        if run_alive(name) or age(v) < GRACE or not os.path.exists(brief):
            return  # running, just dispatched, or never dispatched (the coordinator owns the first dispatch)
        if not os.path.exists(js):
            return
        if tries >= c['impl_retries']:
            stuck(t, stage, r, '%s died %d times without a result' % (name, tries + 1)); return
        if transition(t, stage, r, tries=tries + 1, stage_at=lib.now().isoformat()):
            log('%s r%s: %s died without a result -> dispatched again' % (t, r, name))
            dispatch(t, wt, name, extra)
        return
    if res.get('status') == 'ok' and stage == 'implement':
        # Dead rounds never reach the checks and the review (2026-11-20: three tickets came back `STATUS: blocked` or
        # with an empty diff, and each still paid a full check + review, about an hour, to learn nothing).
        status, notes = impl_report(res, name)
        if status == 'blocked':
            if transition(t, stage, r, stage='triage', why='implementer blocked in round %s: %s' % (r, notes or '(no NOTES)'),
                          findings=res.get('out')):
                log('%s r%s: implementer BLOCKED -> coordinator (%s)' % (t, r, notes[:200]))
            return
        # A fix round that changed nothing but reports `done` on a tree that holds the ticket's work goes on to
        # checks and review: the earlier rounds may already satisfy the findings (2026-11-20: a correct no-op round
        # was sent to triage). Only an empty tree, or a no-op round that does not claim done, is a dead round.
        noop_ok = status == 'done' and r > 1 and tree_changed(wt, st['branch'])
        if not noop_ok and not round_changed(wt, v, st['branch']):
            if not v.get('empty_retry'):
                if transition(t, stage, r, tries=0, empty_retry=1, stage_at=lib.now().isoformat()):
                    log('%s r%s: %s ok but changed nothing -> dispatched again one tier up' % (t, r, name))
                    dispatch(t, wt, name, ['--role', 'escalate'])
                return
            if transition(t, stage, r, stage='triage', why='round %s changed nothing twice (last: %s)' % (r, notes[:300] or res.get('model')),
                          findings=res.get('out')):
                log('%s r%s: empty diff twice -> coordinator' % (t, r))
            return
    if res.get('status') == 'ok':
        if transition(t, stage, r, stage='rebase', tries=0, empty_retry=None):
            log('%s r%s: %s ok (%s, Tier %s)' % (t, r, name, res.get('model'), res.get('level')))
            v = dict(v, stage='rebase')
            rebase(t, v, st, c)
        return
    status = res.get('status')
    if status in ('docker_hung', 'refused', 'excluded', 'coordinator_reserve') or res.get('reason'):
        stuck(t, stage, r, '%s: %s %s' % (name, status, str(res.get('reason', ''))[:200])); return
    if tries >= c['impl_retries']:
        stuck(t, stage, r, '%s: %s after %d tries (%s)' % (name, status, tries + 1, ', '.join(res.get('tried', []))[:200])); return
    if time.time() - os.path.getmtime(js) < c['retry_minutes'] * 60:
        return
    if transition(t, stage, r, tries=tries + 1, stage_at=lib.now().isoformat()):
        log('%s r%s: %s %s -> dispatched again (%d/%d)' % (t, r, name, status, tries + 1, c['impl_retries']))
        dispatch(t, wt, name, extra)


def sync_attention(st):
    p = os.path.join(PD, 'attention.txt')
    want = ['%s r%s %s: %s' % (t, rnd(v), v['stage'], v.get('why', '')) for t, v in st.get('inflight', {}).items()
            if v.get('stage') in ('triage', 'stuck')]
    if want != lines(p):
        write_lines(p, want)


def tick():
    global _PROCS
    _PROCS, STARTED[0], STARTED[1] = None, 0, 0
    st = lib.load_state(M)
    c = cfg(st)
    for t, v in list(st.get('inflight', {}).items()):
        if not isinstance(v, dict) or v.get('stage') not in DRIVEN or not os.path.isdir(wt_of(st, t, v)):
            continue
        try:
            if v['stage'] in ('implement', 'merge'):
                on_run(t, v, st, c)
            elif v['stage'] == 'rebase':
                rebase(t, v, st, c)
            elif v['stage'] == 'final':
                on_final(t, v, st, c)
            else:
                on_review(t, v, st, c)
        except Stop as e:
            stuck(t, v['stage'], rnd(v), str(e))
        except Exception as e:  # one broken ticket never stops the clock for the others
            log('%s: pipeline error %r' % (t, e))
    for t, v in list(st.get('inflight', {}).items()):
        if isinstance(v, dict) and v.get('stage') == 'starting' and age(v) > 45 * 60 \
                and not any(('pipeline start ' + t) in x or ('pipeline" start ' + t) in x for x in procs()):
            stuck(t, 'starting', 1, 'setup or round-1 start did not finish (%s)' % os.path.join(OUT, t + '-start.log'))
    st = lib.load_state(M)
    if c['auto_merge']:
        auto_merge(st, c)
    if c['auto_start']:
        auto_start(lib.load_state(M), c)
    sync_attention(lib.load_state(M))
    collect(c)
    return len(lib.load_state(M).get('inflight', {}))


def collect(c):
    """Worktree garbage collection (lib.gc_worktrees), every `gc_minutes`: only the worktrees in flight stay."""
    stamp = os.path.join(PD, 'gc.stamp')
    every = float(c.get('gc_minutes') or 0) * 60
    if not every or (os.path.exists(stamp) and time.time() - os.path.getmtime(stamp) < every):
        return
    open(stamp, 'w').close()
    try:
        for act, what, why in lib.gc_worktrees(M):
            log('gc %s %s%s' % (act, what, (': ' + why) if why else ''))
    except Exception as e:
        log('gc error %r' % (e,))


def ticket_title(t):
    tf = ticket_file(t)
    first = open(tf).readline().strip().lstrip('#').strip() if os.path.exists(tf) else t
    return re.sub(r'^%s\s*[:-]?\s*' % re.escape(t), '', first) or t


def auto_merge(st, c):
    """`auto_merge`: an approved ticket (full checks passed) is merged by the loop: no wait for the coordinator.
    A conflict goes back to a merge round (cmd_merge); any other failure twice -> stuck."""
    for t, v in list(st.get('inflight', {}).items()):
        if not isinstance(v, dict) or v.get('stage') != 'approved':
            continue
        subj = '%s: %s [%s]' % (c['merge_prefix'], ticket_title(t), t)
        body = 'Approved in round %s; full checks passed. Merged by the pipeline (auto_merge).' % rnd(v)
        p = subprocess.run([sys.executable, SELF, 'merge', t, subj, body], cwd=M, env=env(), capture_output=True,
                           text=True, stdin=subprocess.DEVNULL)
        out = (p.stdout + p.stderr).strip()
        if p.returncode in (0, 4):
            with open(os.path.join(PD, 'merged.txt'), 'a') as f:
                f.write('%s %s r%s %s\n' % (lib.now().isoformat(), t, rnd(v), (out.splitlines() or [''])[-1][:120]))
        elif p.returncode != 3:
            k = int(v.get('merge_fails') or 0) + 1
            if k >= 2:
                stuck(t, 'approved', rnd(v), 'auto merge failed twice (rc=%s): %s' % (p.returncode, out[-300:]))
            else:
                transition(t, None, None, merge_fails=k)
                log('%s r%s: auto merge failed (rc=%s), will retry: %s' % (t, rnd(v), p.returncode, out[-200:]))


def auto_start(st, c):
    """`auto_start`: queued tickets whose blockers are all merged (state.json `done`) and whose `Touches` do not
    overlap a ticket in flight start by themselves, in queue order, up to `target_inflight`. The worktree is created
    from the project branch; `setup` runs in it before round 1, in the background."""
    inf = st.get('inflight', {})
    target = int(c['target_inflight'] or 2 * int(c['max_jobs']))
    room = target - len(inf)
    if room <= 0:
        return
    done, blocked = set(st.get('done', [])), set(st.get('blocked') or [])
    owner = lib.owner_waits(st)  # a ticket that waits on the owner never starts by itself
    busy = set()
    for t in inf:
        busy |= touches_of(t)
    for t in st.get('queue', []):
        if room <= 0:
            break
        if t in inf or t in done or t in blocked or t in owner or not os.path.exists(ticket_file(t)):
            continue
        if any(b not in done for b in (st.get('blockers') or {}).get(t, [])):
            continue
        tt = touches_of(t)
        if overlaps(tt, busy):
            continue
        wt = wt_of(st, t, {})
        if not os.path.isdir(wt):
            br = 'autopilot/' + t
            exists = lib.git(M, 'rev-parse', '-q', '--verify', 'refs/heads/' + br).returncode == 0
            g = lib.git(M, 'worktree', 'add', '-q', *([wt, br] if exists else ['-b', br, wt, st['branch']]))
            if g.returncode:
                log('%s: auto start: worktree add failed: %s' % (t, (g.stderr or g.stdout).strip()[-200:])); continue
        entry = {'wt': wt, 'round': 1, 'stage': 'starting', 'stage_at': lib.now().isoformat()}
        lib.update_state(M, lambda s, t=t, e=entry: s.setdefault('inflight', {}).__setitem__(t, e))
        cmd = '%s"%s" start %s' % (('(%s) && ' % c['setup']) if c['setup'] else '', SELF, t)
        log('%s: auto start (%s)' % (t, wt))
        spawn(['bash', '-c', 'cd "%s" && %s' % (wt, cmd)], out=os.path.join(OUT, t + '-start.log'))
        busy |= tt
        room -= 1


# ---------- the background job: checks, then one review ----------

def cmd_job(t, r, review_only, final=False):
    st = lib.load_state(M)
    v = st.get('inflight', {}).get(t) or {}
    wt, c = wt_of(st, t, v), cfg(st)
    f = open(final_path(t, r) if final else check_path(t, r), 'a')

    def mark(s):
        f.write(MARK + s + '\n'); f.flush()
    mark('PID %d' % os.getpid())
    if not review_only:
        for cmd in (checks_of(st, t) if final else round_checks(st, t)):
            mark('CHECK ' + cmd)
            p = subprocess.Popen(['bash', '-c', cmd], cwd=wt, env=env(), stdin=subprocess.DEVNULL, stdout=f,
                                 stderr=subprocess.STDOUT, start_new_session=True)
            try:
                rc = p.wait(timeout=c['check_timeout_minutes'] * 60)
            except subprocess.TimeoutExpired:
                os.killpg(p.pid, signal.SIGKILL); p.wait(); rc = 124
                f.write('\n(timeout: killed after %s min)\n' % c['check_timeout_minutes'])
            if rc:
                mark('CHECK_FAIL rc=%s `%s`' % (rc, cmd)); mark('DONE'); return
        mark('CHECK_OK')
    if final:
        mark('DONE'); return
    fx = os.path.join(OUT, '%s-fix-%s.md' % (t, r))
    try:
        brief = mkbrief('review', t, r, wt, fx if os.path.exists(fx) else None)
    except Stop as e:
        mark('REVIEW_ERROR ' + str(e)); mark('REVIEW_RC 98'); mark('DONE'); return
    mark('REVIEW_START ' + brief)
    with open(os.path.join(OUT, 'review-%s-%s.txt' % (t, r)), 'w') as rv:
        rc = subprocess.run([tool('review'), t, str(r), brief, '1'], cwd=M, env=env(WT=wt, POOL=v.get('pool')),
                            stdin=subprocess.DEVNULL, stdout=rv, stderr=subprocess.STDOUT).returncode
    mark('REVIEW_RC %s' % rc); mark('DONE')


# ---------- coordinator commands ----------

def cmd_run(a):
    st = lib.load_state(M)
    interval = int(a[a.index('--interval') + 1]) if '--interval' in a else int(cfg(st)['interval'])
    lk = open(os.path.join(PD, 'run.lock'), 'a+')
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit('pipeline: already running for %s (lock %s)' % (M, lk.name))
    if '--once' not in a:
        print('pipeline: running for %s, every %ss (log .autopilot/pipeline/pipeline.log)' % (M, interval), flush=True)
    while True:
        del EVENTS[:]
        try:
            n = tick()
            print('tick %s inflight=%d jobs=%d%s' % (dt.datetime.now().strftime('%H:%M:%S'), n, jobs_running(),
                                                   (' | ' + '; '.join(EVENTS)) if EVENTS else ''), flush=True)
        except Exception as e:
            print('tick %s ERROR %r' % (dt.datetime.now().strftime('%H:%M:%S'), e), flush=True)
        if '--once' in a:
            return
        time.sleep(interval)


def cmd_start(t, a):
    st = lib.load_state(M)
    wt = a[a.index('--wt') + 1] if '--wt' in a else wt_of(st, t, {})
    if not os.path.isdir(wt):
        sys.exit('pipeline start: no worktree %s (git worktree add -b autopilot/%s %s HEAD)' % (wt, t, wt))
    if not os.path.exists(ticket_file(t)):
        sys.exit('pipeline start: no ticket file %s' % ticket_file(t))
    done = set(st.get('done', []))
    miss = [b for b in (st.get('blockers') or {}).get(t, []) if b not in done]
    if miss and '--force' not in a:
        sys.exit('pipeline start: %s is blocked by %s (not merged; --force to start anyway)' % (t, ', '.join(miss)))
    cur = st.get('inflight', {}).get(t) or {}
    if cur.get('stage') in DRIVEN + ('approved', 'merging'):
        sys.exit('pipeline start: %s is already in flight (stage %s, round %s)' % (t, cur['stage'], rnd(cur)))
    entry = dict(cur, wt=os.path.abspath(wt), round=1, stage='implement', stage_at=lib.now().isoformat(), tries=0)
    if '--pool' in a:
        entry['pool'] = a[a.index('--pool') + 1]
    try:
        mkbrief('impl', t, 1, entry['wt'])
    except Stop as e:
        sys.exit('pipeline start: %s' % e)
    lib.update_state(M, lambda s: s.setdefault('inflight', {}).__setitem__(t, entry))
    log('%s r1: started (%s)' % (t, entry['wt']))
    linear_in_progress(t)
    dispatch(t, entry['wt'], '%s-impl-1' % t, [])
    print('STARTED %s round 1 in %s' % (t, entry['wt']))


def cmd_fix(t, findings):
    st = lib.load_state(M)
    v = st.get('inflight', {}).get(t) or sys.exit('pipeline fix: %s is not in flight' % t)
    try:
        fix_round(t, v, st, cfg(st), open(findings).read(), 'coordinator findings', expect=v.get('stage'), forced=True)
    except Stop as e:
        sys.exit('pipeline fix: %s' % e)
    sync_attention(lib.load_state(M))  # a settled triage must not wake wait-approval again before the next tick
    v = lib.load_state(M)['inflight'][t]
    print('%s round %s %s' % (t, rnd(v), v.get('stage')))


def cmd_retry(t):
    st = lib.load_state(M)
    v = st.get('inflight', {}).get(t) or sys.exit('pipeline retry: %s is not in flight' % t)
    if v.get('stage') != 'stuck':
        sys.exit('pipeline retry: %s is at stage %s, not stuck' % (t, v.get('stage')))
    frm, r, wt = v.get('stuck_from') or 'rebase', rnd(v), wt_of(st, t, v)
    lib.resolve_alert(M, 'pipeline_stuck', t)
    if frm == 'starting':
        transition(t, 'stuck', r, stage='starting', why=None, stuck_from=None)
        log('%s: retry start (coordinator)' % t)
        cmd_start(t, ['--force']); return
    if frm == 'final':
        if os.path.exists(final_path(t, r)):
            os.remove(final_path(t, r))
        transition(t, 'stuck', r, stage='final', tries=0, why=None, stuck_from=None)
    elif frm == 'approved':
        transition(t, 'stuck', r, stage='approved', merge_fails=None, why=None, stuck_from=None)
    elif frm in ('implement', 'merge'):
        name, extra = run_args(t, v)
        transition(t, 'stuck', r, stage=frm, tries=0, why=None, stuck_from=None)
        dispatch(t, wt, name, extra)
    elif frm == 'review':
        transition(t, 'stuck', r, stage='review', tries=0, why=None, stuck_from=None)
        start_job(t, r, wt, 'review', review_only='CHECK_OK' in marks(check_path(t, r)))
    else:
        transition(t, 'stuck', r, stage='rebase', tries=0, merges=0, why=None, stuck_from=None)
    sync_attention(lib.load_state(M))
    log('%s r%s: retry %s (coordinator)' % (t, r, frm))
    print('%s r%s: %s again' % (t, r, frm))


def restore_foreign_notes(t, wt):
    """Put back tracked files under docs/notes that belong to other tickets. Browser and screenshot tests rewrite the
    committed evidence of earlier tickets (docs/notes/<OTHER>/*.png) in every tree they run in; on 2026-11-21 one
    ticket's tree held 166 such files, and the squash would have committed them as this ticket's change."""
    out = lib.git(wt, 'diff', '--name-only', 'HEAD', '--', 'docs/notes').stdout.split()
    own = ('docs/notes/%s/' % t, 'docs/notes/%s.' % t, 'docs/notes/%s-' % t)
    foreign = [f for f in out if not f.startswith(own)]
    if foreign:
        lib.git(wt, 'checkout', 'HEAD', '--', *foreign)
        log('%s: restored %d tracked notes of other tickets before the merge' % (t, len(foreign)))


def cmd_merge(t, subj, body):
    """Rebase, squash, finish. A conflict sends the ticket back to a merge round and exits 3."""
    st = lib.load_state(M)
    br, v = st['branch'], st.get('inflight', {}).get(t)
    wt = wt_of(st, t, v)
    if not os.path.isdir(wt):
        sys.exit('pipeline merge: no worktree %s' % wt)
    r = rnd(v or {})
    if v:
        transition(t, None, None, stage='merging')

    def back_to_merge_round(why):
        drop_approved(t)
        if not v:
            return
        transition(t, None, None, stage='rebase', merges=0)
        s2 = lib.load_state(M)
        merge_round(t, s2['inflight'][t], s2, cfg(s2), why)

    restore_foreign_notes(t, wt)
    p = subprocess.run([tool('rebase-wt'), wt, br], capture_output=True, text=True, env=env(), stdin=subprocess.DEVNULL)
    out = (p.stdout + p.stderr).strip()
    if p.returncode:
        print(out[-1500:])
        if p.returncode == 3 or 'CONFLICT' in out:
            back_to_merge_round(out)
            print('REBASE-CONFLICT %s: the rebase is left in progress in %s; merge round dispatched' % (t, wt)); sys.exit(3)
        if v:
            transition(t, 'merging', None, stage='approved')
        sys.exit(p.returncode)
    ahead = lib.git(wt, 'rev-list', '--count', '%s..HEAD' % br).stdout.strip()
    if ahead not in ('', '0'):
        lib.git(wt, 'reset', '-q', '--soft', br)  # one change on top of the branch: finish commits it once
    f = subprocess.run([tool('finish'), t, subj, body], cwd=M, env=env(WT=wt), capture_output=True, text=True, stdin=subprocess.DEVNULL)
    fo = (f.stdout + f.stderr).strip()
    print('\n'.join(fo.splitlines()[-4:]))
    if f.returncode == 3:
        lib.git(M, 'cherry-pick', '--abort')
        p = subprocess.run([tool('rebase-wt'), wt, br], capture_output=True, text=True, env=env(), stdin=subprocess.DEVNULL)
        back_to_merge_round('cherry-pick onto %s conflicted (aborted):\n%s\n\nrebase of the worktree:\n%s' % (br, fo[-800:], (p.stdout + p.stderr)[-1200:]))
        print('MERGE-CONFLICT %s: cherry-pick aborted, the ticket is back to a merge round' % t); sys.exit(3)
    if f.returncode not in (0, 4):
        if v:
            transition(t, 'merging', None, stage='approved')
        sys.exit(f.returncode)
    drop_approved(t)

    def done(s):
        s.get('inflight', {}).pop(t, None)
        if t not in s.setdefault('done', []):
            s['done'].append(t)
        if t in s.get('queue', []):
            s['queue'].remove(t)
    lib.update_state(M, done)
    log('%s r%s: MERGED (%s)' % (t, r, fo.splitlines()[-1] if fo else ''))
    sys.exit(f.returncode)


def milestone_of(st, t):
    for m in st.get('milestones') or []:
        if t in m.get('issues', []):
            return m.get('id') or m.get('name', '')
    return '-'


def who(st, t, v):
    """The model of the current step with its tier: the reviewer while a review runs, else the implementer."""
    r = rnd(v)
    try:
        reg, ad = lib.load_reg(warn=False), lib.adapters()
    except Exception:
        reg, ad = {'models': {}}, {}

    def tier(k):
        m = reg['models'].get(k)
        try:
            lv = lib.level_of(reg, m, ad.get(m['cli'])) if m else None
        except Exception:
            lv = None
        return '%s (T%s)' % (k, lv if lv is not None else '?')
    if v.get('stage') == 'review':
        pre, suf = '%s-rev-' % t, '-%s.md' % r
        fs = sorted(glob.glob(os.path.join(OUT, pre + '*' + suf + '*')), key=os.path.getmtime)
        if fs:
            b = os.path.basename(fs[-1])
            return 'review ' + tier(b[len(pre):b.index(suf)])
    name, _ = run_args(t, v)
    res = result(os.path.join(OUT, name + '.json'))
    if res and res.get('model'):
        return tier(res['model'])
    log_ = st.get('implementer_log', {}).get(t) or []
    return tier(log_[-1]['key']) if log_ else '-'


def detail(t, v):
    s, r = v.get('stage', '?'), rnd(v)
    if s == 'review':
        mk = marks(check_path(t, r))
        if 'DONE' in mk:
            return 'review done'
        return 'review' if 'CHECK_OK' in mk else 'checks'
    if s in ('implement', 'merge'):
        name, _ = run_args(t, v)
        res = result(os.path.join(OUT, name + '.json'))
        return s if not res else '%s %s' % (s, res.get('status'))
    if s == 'rebase':
        return 'rebase (check slot)'
    if s == 'final':
        mk = marks(final_path(t, r))
        return 'full checks' if mk and 'DONE' not in mk else ('final (slot)' if not mk else 'final done')
    return s


def cmd_status():
    st = lib.load_state(M)
    inf = st.get('inflight', {})
    p = subprocess.run([tool('eta')], cwd=M, env=env(), capture_output=True, text=True, stdin=subprocess.DEVNULL)
    eta = p.stdout.splitlines()
    # The verdict first, on its own: RUNNING, DONE, STUCK or WAITING ON OWNER is the one thing the owner must never
    # have to work out from the bars.
    verdict = [x for x in eta if x.startswith('RUN: ')] or [lib.run_state(M, st)['line']]
    eta = [x for x in eta if not x.startswith('RUN: ')]
    print(verdict[0])
    print()
    if not inf:
        print('no ticket in flight')
    for t, v in sorted(inf.items(), key=lambda x: (milestone_of(st, x[0]), x[0])):
        if not isinstance(v, dict):
            continue
        mins = age(v)
        line = '%-10s %-14s r%-3s %-20s %-30s %s' % (t, milestone_of(st, t)[:14], rnd(v), detail(t, v)[:20], who(st, t, v)[:30],
                                                     ('%d min' % (mins // 60)) if mins != float('inf') else '-')
        if v.get('stage') in ('triage', 'stuck'):
            line += '  ' + str(v.get('why', ''))[:120]
        print(line)
    # The REPLAN lines are printed too: this is the view the coordinator shows the owner at every update, and
    # cutting them here (as before 2026-11-15) meant the re-plan triggers never reached the coordinator.
    if eta:
        print()
        print('\n'.join(eta))


def cmd_wait(a):
    def opt(flag, default):
        return float(a[a.index(flag) + 1]) if flag in a else default
    interval, tick_s, stuck_after = opt('--interval', 15), opt('--tick', 600), opt('--stuck-after', 300)
    ap, at = os.path.join(PD, 'approved.txt'), os.path.join(PD, 'attention.txt')
    t0, stuck_since, settled = time.time(), None, 0
    while True:
        ok, att = lines(ap), lines(at)
        if ok or att:
            print('\n'.join(ok + ['ATTENTION: ' + x for x in att]))
            return
        # A wait that can no longer be answered is the failure of 2026-11-22: the coordinator slept on a pipeline with
        # nothing left to approve. So the wait also ends when the run is over, waits on the owner, or stopped moving.
        rs = lib.run_state(M)
        now = time.time()
        if rs['state'] in ('DONE', 'WAITING ON OWNER'):
            settled += 1
            if settled >= 2:  # two readings: a merge in progress is not the end of the run
                print(rs['line'])
                return
        else:
            settled = 0
        if rs['state'] in ('STUCK', 'STOPPED'):
            stuck_since = stuck_since or now
            if now - stuck_since >= stuck_after:
                print(rs['line'])
                return
        else:
            stuck_since = None
        if tick_s and now - t0 >= tick_s:
            print('TICK')
            print(rs['line'])
            return
        time.sleep(interval)


def main(a):
    global M, PD, OUT
    if not a or a[0] in ('-h', '--help'):
        print(__doc__); sys.exit(0 if a else 1)
    M = lib.find_repo()
    PD, OUT = os.path.join(M, '.autopilot', 'pipeline'), os.path.join(M, '.autopilot', 'out')
    os.makedirs(PD, exist_ok=True); os.makedirs(OUT, exist_ok=True)
    cmd = a[0]
    if cmd == 'run':
        cmd_run(a[1:])
    elif cmd == '_job' and len(a) >= 3:
        cmd_job(a[1], int(a[2]), '--review-only' in a, '--final' in a)
    elif cmd == 'start' and len(a) >= 2:
        cmd_start(a[1], a[2:])
    elif cmd == 'fix' and len(a) == 3:
        cmd_fix(a[1], a[2])
    elif cmd == 'retry' and len(a) == 2:
        cmd_retry(a[1])
    elif cmd == 'merge' and len(a) == 4:
        cmd_merge(a[1], a[2], a[3])
    elif cmd == 'status':
        cmd_status()
    elif cmd == 'wait-approval':
        cmd_wait(a[1:])
    else:
        print(__doc__); sys.exit(1)


if __name__ == '__main__':
    main(sys.argv[1:])
